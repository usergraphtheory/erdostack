  "keywords": [
    "agent-skills",
    "graph",
    "graph-database",
    "knowledge-graph",
    "graph-theory",
    "graph-algorithms",
    "graph-visualization",
    "data-structures",
    "cypher",
    "gql",
    "sql-pgq",
    "neo4j",
    "ladybugdb",
    "crdt"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "erdostack",
