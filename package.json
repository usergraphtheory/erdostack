    "graph-algorithms",
    "graph-visualization",
    "data-structures",
    "cypher",
    "gql",
    "sql-pgq",
    "gremlin",
    "sparql",
    "neo4j",
    "ladybugdb",
    "crdt",
    "graphrag"
  ],
  "homepage": "https://github.com/usergraphtheory/erdostack#readme",
  "bugs": {
    "url": "https://github.com/usergraphtheory/erdostack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usergraphtheory/erdostack.git"
  },
